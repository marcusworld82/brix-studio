# BRIX personal edition. Copy to .env.local and fill blanks.
# Each customer supplies their own backend, sender and private credentials.
BRIX_EDITION=personal
APP_BACKEND=supabase
APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=BRIX
NEXT_PUBLIC_BRAND_INITIALS=BX
NEXT_PUBLIC_BRAND_ACCENT="#006494"
NEXT_PUBLIC_SUPPORT_EMAIL=
SUPPORT_EMAIL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Exactly 64 hexadecimal characters. Keep stable and backed up securely.
API_KEY_ENCRYPTION_SECRET=
AUTH_RESEND_KEY=
# Use a mailbox at your Resend-verified sending domain.
EMAIL_FROM=
ADMIN_EMAILS=
HF_API_BASE_URL=https://api.higgsfield.ai
HF_WEBHOOK_SECRET=
# Public HTTPS origin in production. Local development needs a tunnel for callbacks.
HF_WEBHOOK_BASE_URL=
CRON_SECRET=
HF_PRICE_GUARD=true
RUN_TIMEOUT_MINUTES=30
E2E_TEST_MODE=false
# Do not set HF_CREDENTIALS. Users connect their own complete API key in Account.
# No Stripe, MongoDB, shared provider key or public media bucket is required.
